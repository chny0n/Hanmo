{
  "name": "hanmo-degree-rescue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app/main.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=public/app.js && node scripts/stage-static.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/core",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
