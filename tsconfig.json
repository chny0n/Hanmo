{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "vitest/globals",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "js/academic/**/*.ts",
    "js/academic/core/academic-display.js",
    "js/academic/core/academic-display.test.js",
    "js/academic/core/academics/faculty-search.js",
    "js/academic/core/academics/faculty-search.test.js"
  ]
}
